{
  "name": "@nestjs/skills",
  "version": "0.1.0",
  "description": "Official NestJS agent skills: build and extend NestJS applications with coding agents (Claude Code, Codex, Cursor and any Agent Skills reader)",
  "author": "Kamil Mysliwiec",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "nestjs-skills": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "bin",
    "skills",
    ".claude-plugin",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "validate": "node scripts/validate.js",
    "test": "node --test test/cli.test.js",
    "prepublishOnly": "npm run validate && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nestjs/agent-skills.git"
  },
  "homepage": "https://github.com/nestjs/agent-skills#readme",
  "bugs": {
    "url": "https://github.com/nestjs/agent-skills/issues"
  },
  "keywords": [
    "nestjs",
    "nest",
    "agent-skills",
    "skills",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "typescript",
    "nodejs"
  ]
}
